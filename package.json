{
  "name": "inventory-sync",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "server": "node server.js",
    "server-no-scanner": "node server-no-scanner.js",
    "frontend": "cd frontend && npm run dev",
    "install-all": "npm install && cd frontend && npm install",
    "dev": "concurrently \"npm run server-no-scanner\" \"npm run frontend\"",
    "dev-with-scanner": "concurrently \"npm run server\" \"npm run frontend\"",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "ingestor": "node ingestor.js",
    "check-db": "node check-db.js",
    "clear-db": "rm -f inventory-sync.db inventory-sync.db-shm inventory-sync.db-wal"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Sistema de gestión de inventario con lector de códigos de barras",
  "dependencies": {
    "axios": "^1.13.1",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
