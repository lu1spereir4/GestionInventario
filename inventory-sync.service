[Unit]
Description=Inventory Sync Server with USB barcode listener
After=network.target

[Service]
Type=simple
# Cambia el usuario al que ejecutará el servicio si es necesario.
User=lu1s
Group=lu1s
WorkingDirectory=/home/lu1s/inventory-sync
# Ajusta el dispositivo USB y, si lo deseas, el entorno.
Environment=USB_SCANNER_DEVICE=/dev/input/event6
Environment=NODE_ENV=production
# Ruta al script helper que prepara el entorno.
ExecStart=/home/lu1s/inventory-sync/start-inventory-service.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
